rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissive rules for multi-tenant TaxiControl operations (PSM COMERCIAL LUENA MOXICO)
    // Developed dynamically to bypass Firebase Authentication "operation-not-allowed" console errors.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
