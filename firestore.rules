rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users collection (used for both Firebase Auth sync and local credentials fallback)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Global Passengers & Profiles collection (Ecosystem wide, not tied to a single tenant)
    match /passengers/{passengerId} {
      allow read, write: if true;
    }
    match /passenger_profiles/{profileId} {
      allow read, write: if true;
    }
    match /passenger_ratings/{ratingId} {
      allow read, write: if true;
    }

    // 3. Tenants & all tenant-scoped subcollections (Dynamic Multi-tenant)
    match /tenants/{tenantId} {
      allow read, write: if true;

      // Recursively allow all nested collections (vehicles, speed violations, revenue logs, messages, etc.)
      // This is crucial to support local collaborator sessions where Firebase Auth is bypassed.
      match /{document=**} {
        allow read, write: if true;
      }
    }
  }
}
