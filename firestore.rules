rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Security & Role Helper Functions
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'joseiwezasuana@gmail.com' ||
        request.auth.token.email == 'jis@taxicontrol.ao' ||
        (request.auth.token.email != null && request.auth.token.email.endsWith('@taxicontrol.ao')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    // Retrieve assigned tenant of user from users collection
    function getUserTenant() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId != "" ?
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId :
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenant != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenant != "" ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenant :
            'psm'
          )
        ) : 'psm';
    }

    // Check if the user belongs to the tenant they are trying to access
    function belongsToTenant(tenantId) {
      return isSignedIn() && (
        isMasterAdmin() || 
        getUserTenant() == tenantId
      );
    }

    // Match document tenantId to user's assigned tenant for root collections
    function isDocInUserTenant(docData) {
      return isMasterAdmin() || (
        (docData.tenantId != null && docData.tenantId == getUserTenant()) ||
        (docData.tenant != null && docData.tenant == getUserTenant()) ||
        (!('tenantId' in docData) && !('tenant' in docData) && getUserTenant() == 'psm')
      );
    }

    function isIncomingInUserTenant() {
      return isMasterAdmin() || (
        (!('tenantId' in request.resource.data) && !('tenant' in request.resource.data)) ||
        (request.resource.data.tenantId == getUserTenant()) ||
        (request.resource.data.tenant == getUserTenant())
      );
    }

    // =========================================================================
    // User Management & Profiles
    // =========================================================================

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isMasterAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isMasterAdmin());
      allow delete: if isMasterAdmin();
    }

    match /admins/{userId} {
      allow read: if isMasterAdmin();
      allow write: if isMasterAdmin();
    }

    // =========================================================================
    // Public & Global Platform Infrastructure
    // =========================================================================

    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /access_codes/{codeId} {
      allow read: if true;
      allow write: if true; // Registration & activation flow
    }

    match /taxi_requests/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    match /passengers/{passengerId} {
      allow read, write: if true;
    }

    match /passenger_profiles/{profileId} {
      allow read, write: if true;
    }

    match /passenger_ratings/{ratingId} {
      allow read, write: if true;
    }

    match /system_backups/{backupId} {
      allow read: if isMasterAdmin();
      allow write: if isMasterAdmin();
    }

    match /system_error_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn() || isMasterAdmin();
    }

    // =========================================================================
    // Root-Level Sensitive Operational Collections (Strict Tenant Validation)
    // =========================================================================

    match /drivers/{driverId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /drivers_master/{driverId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /master_vehicles/{vehicleId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /shifts/{shiftId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /financials/{financialId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /revenue_logs/{revenueId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /administrative_staff/{staffId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /driver_scales/{scaleId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /salary_sheets/{sheetId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /maintenance_logs/{logId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /accident_logs/{accidentId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /rac_contracts/{contractId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    match /internal_contracts/{contractId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
      allow create: if isSignedIn() && isIncomingInUserTenant();
      allow update, delete: if isSignedIn() && (isMasterAdmin() || isDocInUserTenant(resource.data));
    }

    // =========================================================================
    // Tenant Management & Scoped Subcollections (Strict Multi-tenancy Isolation)
    // =========================================================================

    match /tenants/{tenantId} {
      allow read: if true; // Public listing of tenant names/company profiles
      allow write: if isMasterAdmin();

      // Tenant-specific Subcollections - STRICTLY ISOLATED TO TENANT MEMBERS
      match /settings/{docId} {
        allow read: if true;
        allow write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /taxi_requests/{requestId} {
        allow read, write: if true;
      }

      match /access_codes/{codeId} {
        allow read, write: if true; // Used for registration/code activation
      }

      match /drivers/{driverId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /drivers_master/{driverId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /vehicles/{vehicleId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /master_vehicles/{vehicleId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /shifts/{shiftId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /financials/{financialId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /transactions/{transactionId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /revenue_logs/{revenueId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /administrative_staff/{staffId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /driver_scales/{scaleId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /salary_sheets/{sheetId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /maintenance_logs/{logId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /accident_logs/{accidentId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /rac_contracts/{contractId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /internal_contracts/{contractId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /panic_alerts/{alertId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /messages/{messageId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      match /sms_logs/{logId} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }

      // Catch-all inside tenant document hierarchy
      match /{document=**} {
        allow read, write: if belongsToTenant(tenantId) || isMasterAdmin();
      }
    }

    // =========================================================================
    // Default Deny Rule
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
